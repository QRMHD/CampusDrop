# ─── Supabase credentials (required) ───
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Port the server listens on (Cloud Run provides this automatically)
PORT=8080

# Node environment (development | production)
NODE_ENV=production

# Frontend API URL (optional in production; defaults to same-origin /api)
# VITE_API_URL=https://campusdrop-<project>-<region>.a.run.app/api
